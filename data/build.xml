<?xml version="1.0" encoding="UTF-8"?>
<build>
 <module key="admin/spamtroll"><![CDATA[{"default_controller":"dashboard","protected":false,"default":null}]]></module>
 <hook key="Post"><![CDATA[{"type":"C","class":"\\IPS\\forums\\Topic\\Post"}]]></hook>
