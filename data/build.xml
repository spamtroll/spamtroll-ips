 <hook key="Member"><![CDATA[{"type":"C","class":"\\IPS\\Member"}]]></hook>
 <setting key="spamtroll_api_key"><![CDATA[{"key":"spamtroll_api_key","default":""}]]></setting>
 <setting key="spamtroll_api_url"><![CDATA[{"key":"spamtroll_api_url","default":"https://api.spamtroll.io/api/v1"}]]></setting>
 <setting key="spamtroll_enabled"><![CDATA[{"key":"spamtroll_enabled","default":"0"}]]></setting>
