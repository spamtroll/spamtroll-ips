includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - Application.php
        - sources
        - modules
        - widgets
        - tasks
        - extensions
        - setup
        # IPS hook files start with `//<?php`, so they are not valid PHP
        # until the Suite rewrites them. `composer stan` runs
        # dev/preprocess-hooks.php first, which applies exactly the
        # transformation the Suite applies (SUITE-FACTS U12) and drops the
        # result here. Analysing the output means the hooks are covered by
        # the same level-9 rules as everything else.
        - build/hooks-preprocessed
    excludePaths:
        # Language tables are not code; the `<?php` opens, the array
        # is assigned, end-of-file. Nothing to analyse.
        - dev/lang.php
        - dev/lang_pl.php
        - dev/lang_de.php
    bootstrapFiles:
        - vendor/autoload.php
        # Loads stubs/IPS.stub.php and registers the `_Foo` -> `Foo` aliases
        # the IPS autoloader would create at runtime.
        - stubs/aliases.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    tmpDir: .phpstan-cache
